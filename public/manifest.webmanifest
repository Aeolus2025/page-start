{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "Page Start",
  "short_name": "Page Start",
  "description": "一个简洁的导航起始页",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0b1020",
  "theme_color": "#0b1020",
  "icons": [
    {
      "src": "/icons/logo.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/logo.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}
