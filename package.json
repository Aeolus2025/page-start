{
  "name": "page-start",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc -b --pretty false",
    "lint": "eslint .",
    "format": "prettier . --write",
    "sync:manifest-version": "node scripts/sync-manifest-version.mjs",
    "sync:version-from-tag": "node scripts/sync-version-from-tag.mjs",
    "verify:dist-manifest": "node scripts/verify-dist-manifest.mjs",
    "pack:zip": "node scripts/pack-zip.mjs",
    "build": "npm run sync:manifest-version && vue-tsc -b && vite build",
    "preview": "vite preview",
    "ci": "npm run typecheck && npm run lint && npm run build && npm run verify:dist-manifest",
    "prepare": "husky"
  },
  "dependencies": {
    "pinia": "^2.2.6",
    "vue": "^3.5.25"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^6.0.2",
    "jiti": "^2.4.2",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.3.1",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^2.2.0"
  }
}
